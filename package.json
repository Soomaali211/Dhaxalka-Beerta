{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/run-regression-tests.ts",
    "apk:init": "npm run build && npx cap add android && node scripts/configure-android-permissions.mjs",
    "apk:sync": "npm run build && npx cap sync android && node scripts/configure-android-permissions.mjs",
    "apk:build": "npm run apk:sync && chmod +x android/gradlew && ./android/gradlew -p android assembleRelease --no-daemon -Dorg.gradle.jvmargs=\"-Xmx768m -XX:MaxMetaspaceSize=384m\" --max-workers=1 && cp android/app/build/outputs/apk/release/app-release.apk ./Beerta-iyo-Dhaxalka.apk",
    "apk:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vis.gl/react-google-maps": "^1.10.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "proj4": "^2.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/proj4": "^2.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
